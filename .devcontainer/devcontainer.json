{
  "name": "ELC site (Jekyll)",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.1",

  // Gemfile.lock pins jekyll 4.2.1, which needs webrick to serve.
  // Ruby 3.x dropped webrick from stdlib, so install it into the bundle
  // here rather than adding it to the repo's Gemfile.
  "postCreateCommand": "bundle config set --local path vendor/bundle && bundle install && bundle add webrick --skip-install || true",

  "forwardPorts": [4000, 35729],
  "portsAttributes": {
    "4000": { "label": "Jekyll site", "onAutoForward": "openPreview" },
    "35729": { "label": "LiveReload", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "sissel.shopify-liquid"
      ],
      "settings": {
        "files.associations": { "*.md": "markdown" }
      }
    }
  }
}
